# Copy to .env and fill in. Never commit the result — .env is gitignored.
# Every variable is documented in docs/configuration.md.

# --- Django ---------------------------------------------------------------
# DEBUG is parsed as an integer: 1 or 0. "true"/"false" will crash on startup.
DEBUG=0
# Required. Comma-separated, no spaces. Django refuses requests for any other Host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Needed only when the public origin differs from what Django sees (reverse proxy,
# platform-assigned hostname). Include the scheme. Without it, admin login fails
# the CSRF origin check.
CSRF_TRUSTED_ORIGINS=
# Set to 1 only when a proxy in front of this app terminates TLS *and* strips any
# client-supplied X-Forwarded-Proto header.
USE_X_FORWARDED_PROTO=0

# --- Firebase Cloud Messaging ---------------------------------------------
# Supply the service account one way or the other, not both.
#
# FIREBASE_CREDENTIALS_FILE is the path inside the container. With the provided
# docker-compose.yml, put the JSON at ./secrets/firebase-service-account.json and
# uncomment the line below.
#FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
#
# FIREBASE_CREDENTIALS_JSON holds the same JSON inline. Convenient on platforms
# with a secrets UI; unusable in a Docker Compose env_file, which cannot carry the
# multi-line private key.
#FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# --- App attestation ------------------------------------------------------
# Android — Play Integrity. All three are required for the settings module to import.
APK_NAME=com.companyname.appname
GOOGLE_PLAY_INTEGRITY_DECRYPTION_KEY=
GOOGLE_PLAY_INTEGRITY_VERIFICATION_KEY=
GOOGLE_PLAY_INTEGRITY_APP_SIGNING_KEY=

# iOS — App Attest. "<TEAM ID>.<bundle id>".
APP_ATTEST_APP_ID=

# --- Database -------------------------------------------------------------
PG_DATABASE=pluto_notifications
PG_USER=pluto
PG_PASSWORD=
# Ignored when running under docker-compose.yml, which sets these to the db service.
PG_HOST=localhost
PG_PORT=5432

# --- Container runtime (optional) ----------------------------------------
# Host port the API is published on by docker-compose.
#API_PORT=8000
# Gunicorn sizing. A rule of thumb is (2 x CPU cores) + 1 workers.
#WEB_CONCURRENCY=3
#GUNICORN_THREADS=2
#GUNICORN_TIMEOUT=60
# Set to 0 when several replicas start at once, or the platform runs migrations
# as a separate release step.
#RUN_MIGRATIONS=1
#RUN_COLLECTSTATIC=1
