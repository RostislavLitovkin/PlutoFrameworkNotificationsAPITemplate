# The container entrypoint is executed by /bin/sh inside Linux. A CRLF line ending
# on the shebang line makes the kernel look for an interpreter named "/bin/sh\r",
# which fails with a confusing "no such file or directory". Force LF regardless of
# the checkout platform or core.autocrlf.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
